{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "kuberik chart values",
  "type": "object",
  "additionalProperties": true,
  "required": ["namespace", "rolloutController", "integrations", "dashboard"],
  "properties": {
    "namespace": {
      "type": "string",
      "minLength": 1
    },
    "rolloutController": {
      "type": "object",
      "additionalProperties": true,
      "required": ["enabled", "image", "resources", "replicas", "logLevel"],
      "properties": {
        "enabled": { "type": "boolean" },
        "replicas": { "type": "integer", "minimum": 1 },
        "logLevel": {
          "type": "string",
          "enum": ["debug", "info", "warn", "error"]
        },
        "image": {
          "type": "object",
          "required": ["repository", "pullPolicy"],
          "properties": {
            "repository": { "type": "string", "minLength": 1 },
            "tag": { "type": "string" },
            "pullPolicy": {
              "type": "string",
              "enum": ["Always", "IfNotPresent", "Never"]
            }
          }
        },
        "resources": { "type": "object" },
        "serviceAccount": {
          "type": "object",
          "properties": {
            "name": { "type": "string" },
            "annotations": { "type": "object" }
          }
        }
      }
    },
    "integrations": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "datadog":     { "type": "object", "properties": { "enabled": { "type": "boolean" } } },
        "prometheus":  { "type": "object", "properties": { "enabled": { "type": "boolean" } } },
        "openkruise":  { "type": "object", "properties": { "enabled": { "type": "boolean" } } },
        "environment": { "type": "object", "properties": { "enabled": { "type": "boolean" } } }
      }
    },
    "dashboard": {
      "type": "object",
      "properties": { "enabled": { "type": "boolean" } }
    },
    "podSecurityContext": { "type": "object" },
    "nodeSelector": { "type": "object" },
    "tolerations": { "type": "array" },
    "affinity": { "type": "object" }
  }
}
